rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'fullName', 'email']) &&
        data.keys().hasOnly(['id', 'fullName', 'email', 'phone', 'role', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == request.auth.uid &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 128 &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 256 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        (!('role' in data) || data.role == 'customer') &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Saved project configuration validation
    function isValidSavedProject(data) {
      return data.keys().hasAll(['id', 'userId', 'modelId', 'totalPrice', 'savedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.modelId is string && data.modelId.size() > 0 && data.modelId.size() <= 64 &&
        data.totalPrice is number && data.totalPrice >= 0 &&
        data.savedAt is string && data.savedAt.size() <= 64 &&
        (!('name' in data) || (data.name is string && data.name.size() <= 128)) &&
        (!('modelName' in data) || (data.modelName is string && data.modelName.size() <= 128)) &&
        (!('currency' in data) || (data.currency is string && data.currency.size() <= 10));
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Disallow querying users collection broadly
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().id == existing().id;
      allow delete: if false;

      // User's saved custom 3D house projects
      match /projects/{projectId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(projectId) && isValidSavedProject(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(projectId) && isValidSavedProject(incoming()) && incoming().userId == userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(projectId);
      }
    }
  }
}
